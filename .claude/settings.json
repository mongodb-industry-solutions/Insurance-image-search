{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.pub)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/.bashrc)",
      "Read(**/.bash_profile)",
      "Read(**/.bash_login)",
      "Read(**/.profile)",
      "Read(**/.zshrc)",
      "Read(**/.zprofile)",
      "Read(**/.zshenv)",
      "Read(**/.bash_history)",
      "Read(**/.zsh_history)",
      "Read(**/.netrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.gitconfig)",

      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/id_rsa)",
      "Edit(**/credentials)",
      "Edit(**/credentials.json)",
      "Edit(**/.bashrc)",
      "Edit(**/.bash_profile)",
      "Edit(**/.zshrc)",
      "Edit(**/.zprofile)",
      "Edit(**/.ssh/**)",
      "Edit(**/.aws/**)",
      "Edit(**/.kube/config)",
      "Edit(**/.netrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.pypirc)",

      "Bash(kubectl:*)",
      "Bash(kubectl *)",
      "Bash(helm:*)",
      "Bash(helm *)",
      "Bash(ksec:*)",
      "Bash(ksec *)",
      "Bash(kubeseal:*)",
      "Bash(kubeseal *)",
      "Bash(git commit *)",

      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(export:*)",
      "Bash(echo *)"
    ]
  }
}
